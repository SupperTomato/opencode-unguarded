#!/usr/bin/env bash
set -euo pipefail

resolve_self() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ $source != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

die() {
  echo "opencode-unguarded: $*" >&2
  exit 1
}

here="$(resolve_self)"
root="$(cd "$here/.." && pwd)"
binary="$root/libexec/opencode"
profile="${OPENCODE_UNGUARDED_PROFILE:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode-unguarded/profile}"

[ -x "$binary" ] || die "missing binary at $binary"

# A dry run must not create, delete, chmod, migrate, or log to a file, so it
# skips every step that would. The executable's own dry-run path performs the
# same policy checks without writing.
dry=0
for arg in "$@"; do
  [ "$arg" = "--dry-run" ] && dry=1
done

# ---------------------------------------------------------------------------
# Reject inherited settings before creating anything on disk.
# ---------------------------------------------------------------------------
case "$profile" in
  /*) ;;
  *) die "OPENCODE_UNGUARDED_PROFILE must be an absolute path (got: $profile)" ;;
esac

for name in OPENCODE_CONFIG_DIR OPENCODE_CONFIG OPENCODE_CONFIG_CONTENT OPENCODE_TEST_HOME; do
  if [ -n "${!name:-}" ]; then
    die "refusing inherited $name; it would escape this profile (unset it, or configure $profile/config/opencode)"
  fi
done

if [ -n "${OPENCODE_DB:-}" ] && [ "${OPENCODE_DB}" != ":memory:" ]; then
  case "${OPENCODE_DB}" in
    /*) die "refusing absolute OPENCODE_DB (${OPENCODE_DB}); it would escape this profile" ;;
    *\\*) die "refusing OPENCODE_DB containing a backslash (${OPENCODE_DB})" ;;
  esac
  case "/${OPENCODE_DB}/" in
    */../*) die "refusing OPENCODE_DB with a '..' component (${OPENCODE_DB})" ;;
  esac
  case "${OPENCODE_DB}" in
    */*) die "refusing nested OPENCODE_DB (${OPENCODE_DB}); use a plain filename inside the profile" ;;
  esac
fi

if [ -n "${OPENCODE_SERVER_URL:-}" ] || [ -n "${OPENCODE_SERVER:-}" ]; then
  die "refusing inherited server attachment; pass --server explicitly"
fi

canonical_allow_missing() {
  # Resolve an absolute path whose leaf may not exist yet. Walk up until an
  # existing *directory* is found, so an existing regular file (such as an
  # initialised database) is not mistaken for a directory.
  local target="$1" suffix=""
  while [ ! -d "$target" ]; do
    [ "$target" = "/" ] && break
    suffix="/$(basename "$target")$suffix"
    target="$(dirname "$target")"
  done
  printf '%s%s' "$(cd -P "$target" && pwd)" "$suffix"
}

profile_real="$(canonical_allow_missing "$profile")"
[ "$profile_real" = "/" ] && die "refusing the filesystem root as a profile"

# Stock storage that is actually in use, not only the conventional defaults.
stock_roots() {
  printf '%s\n' \
    "${XDG_DATA_HOME:-$HOME/.local/share}/opencode" \
    "${XDG_CONFIG_HOME:-$HOME/.config}/opencode" \
    "${XDG_CACHE_HOME:-$HOME/.cache}/opencode" \
    "${XDG_STATE_HOME:-$HOME/.local/state}/opencode" \
    "$HOME/.local/share/opencode" \
    "$HOME/.config/opencode" \
    "$HOME/.cache/opencode" \
    "$HOME/.local/state/opencode"
}

overlaps() {
  case "$1" in
    "$2"|"$2"/*) return 0 ;;
  esac
  case "$2" in
    "$1"/*) return 0 ;;
  esac
  return 1
}

for stock in $(stock_roots); do
  stock_real="$(canonical_allow_missing "$stock")"
  if overlaps "$profile_real" "$stock" || overlaps "$profile_real" "$stock_real"; then
    die "refusing a profile overlapping stock OpenCode storage: $profile_real"
  fi
done

# Reject a symlink on any existing component between the profile and the
# application directories. `-L` catches a dangling link, which `-d` would miss.
assert_no_links() {
  local base="$1" relative="$2" current="$1" part kinds="$3"
  IFS='/' read -r -a parts <<<"$relative"
  local index=0 total=${#parts[@]}
  for part in "${parts[@]}"; do
    index=$((index + 1))
    [ -n "$part" ] || continue
    current="$current/$part"
    if [ -L "$current" ]; then
      if [ "$index" -eq 1 ]; then
        die "refusing symlinked profile storage: $current -> $(readlink "$current")"
      fi
      die "refusing symlinked application directory: $current -> $(readlink "$current")"
    fi
    if [ -e "$current" ] && [ ! -d "$current" ]; then
      die "refusing a non-directory in the storage path: $current"
    fi
    if [ ! -e "$current" ]; then
      return 0
    fi
  done
}

for name in data config cache state tmp; do
  assert_no_links "$profile_real" "$name" "profile"
  assert_no_links "$profile_real" "$name/opencode" "application"
done

# Existing storage must be sound before anything is created or chmodded.
for name in data config cache state tmp; do
  directory="$profile_real/$name"
  if [ -e "$directory" ]; then
    resolved="$(cd -P "$directory" && pwd)"
    [ "$resolved" = "$directory" ] || die "refusing symlinked profile storage: $name -> $resolved"
    [ -O "$directory" ] || die "profile storage is not owned by the current user: $directory"
  fi
done

# The database must stay inside the profile data directory. This is checked for
# the default filename too, because a symlinked default would silently redirect
# SQLite writes outside the profile. SQLite creates `-wal`, `-shm`, and possibly
# `-journal` beside the database, so those are checked as well.
data_real="$profile_real/data/opencode"
database="${OPENCODE_DB:-opencode-unguarded.db}"
if [ "$database" != ":memory:" ]; then
  for suffix in "" -wal -shm -journal; do
    target="$data_real/$database$suffix"
    [ ! -L "$target" ] || die "refusing a symlinked database file: $target -> $(readlink "$target")"
    if [ -e "$target" ] && [ ! -f "$target" ]; then
      die "refusing a non-file database path: $target"
    fi
    if [ -f "$target" ]; then
      links="$(stat -c '%h' "$target" 2>/dev/null || echo 1)"
      [ "$links" = "1" ] || die "refusing a hard-linked database file: $target"
    fi
  done
  db_real="$(canonical_allow_missing "$data_real/$database")"
  case "$db_real" in
    "$data_real"/*) ;;
    *) die "refusing a database outside the derivative data directory: $db_real" ;;
  esac
fi

# An application directory being real does not make its children safe: a
# symlinked log directory, config file, credential file, or service record would
# still redirect an application write into stock storage.
assert_no_linked_children() {
  local directory="$1" entry
  [ -d "$directory" ] || return 0
  for entry in "$directory"/* "$directory"/.[!.]*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    if [ -L "$entry" ]; then
      die "refusing symlinked application storage: $entry -> $(readlink "$entry")"
    fi
  done
}

for name in data config cache state; do
  assert_no_linked_children "$profile_real/$name/opencode"
done

# Every check above has passed. Only now may the launcher create directories and
# tighten permissions; a rejected invocation must leave the filesystem unchanged.
if [ "$dry" -eq 0 ]; then
  mkdir -p "$profile_real/data" "$profile_real/config" "$profile_real/cache" "$profile_real/state" "$profile_real/tmp"
  for name in data config cache state tmp; do
    directory="$profile_real/$name"
    resolved="$(cd -P "$directory" && pwd)"
    [ "$resolved" = "$directory" ] || die "refusing symlinked profile storage: $name -> $resolved"
    [ -O "$directory" ] || die "profile storage is not owned by the current user: $directory"
    chmod 700 "$directory" 2>/dev/null || true
    appdir="$profile_real/$name/opencode"
    mkdir -p "$appdir"
    resolved="$(cd -P "$appdir" && pwd)"
    [ "$resolved" = "$appdir" ] || die "refusing escaped application directory: $name/opencode -> $resolved"
    [ -O "$appdir" ] || die "application directory is not owned by the current user: $appdir"
    chmod 700 "$appdir" 2>/dev/null || true
  done
fi

export OPENCODE_UNGUARDED_PROFILE="$profile_real"
export OPENCODE_UNGUARDED_ROOT="$root"
if [ -n "${OPENCODE_DB:-}" ]; then
  export OPENCODE_DB
else
  unset OPENCODE_DB
fi
export XDG_DATA_HOME="$profile_real/data"
export XDG_CONFIG_HOME="$profile_real/config"
export XDG_CACHE_HOME="$profile_real/cache"
export XDG_STATE_HOME="$profile_real/state"
export TMPDIR="$profile_real/tmp"

exec "$binary" "$@"
