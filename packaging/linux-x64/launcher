#!/usr/bin/env bash
set -euo pipefail

resolve_self() {
  local source="${BASH_SOURCE[0]}"
  while [ -L "$source" ]; do
    local dir
    dir="$(cd -P "$(dirname "$source")" && pwd)"
    source="$(readlink "$source")"
    [[ $source != /* ]] && source="$dir/$source"
  done
  cd -P "$(dirname "$source")" && pwd
}

die() {
  echo "opencode-unguarded: $*" >&2
  exit 1
}

here="$(resolve_self)"
root="$(cd "$here/.." && pwd)"
binary="$root/libexec/opencode"
profile="${OPENCODE_UNGUARDED_PROFILE:-${XDG_DATA_HOME:-$HOME/.local/share}/opencode-unguarded/profile}"

[ -x "$binary" ] || die "missing binary at $binary"

# ---------------------------------------------------------------------------
# Reject inherited settings before creating anything on disk.
# ---------------------------------------------------------------------------
case "$profile" in
  /*) ;;
  *) die "OPENCODE_UNGUARDED_PROFILE must be an absolute path (got: $profile)" ;;
esac

for name in OPENCODE_CONFIG_DIR OPENCODE_CONFIG OPENCODE_CONFIG_CONTENT OPENCODE_TEST_HOME; do
  if [ -n "${!name:-}" ]; then
    die "refusing inherited $name; it would escape this profile (unset it, or configure $profile/config/opencode)"
  fi
done

if [ -n "${OPENCODE_DB:-}" ] && [ "${OPENCODE_DB}" != ":memory:" ]; then
  case "${OPENCODE_DB}" in
    /*) die "refusing absolute OPENCODE_DB (${OPENCODE_DB}); it would escape this profile" ;;
  esac
  case "/${OPENCODE_DB}/" in
    */../*) die "refusing OPENCODE_DB with a '..' component (${OPENCODE_DB})" ;;
  esac
fi

canonical_allow_missing() {
  # Resolve an absolute path whose leaf may not exist yet. Every existing
  # component is canonicalized, so a symlinked parent cannot redirect it.
  local target="$1" suffix=""
  while [ ! -e "$target" ]; do
    suffix="/$(basename "$target")$suffix"
    target="$(dirname "$target")"
  done
  printf '%s%s' "$(cd -P "$target" && pwd)" "$suffix"
}

profile_real="$(canonical_allow_missing "$profile")"
case "$profile_real" in
  "$HOME/.local/share/opencode"|"$HOME/.local/share/opencode/"*)
    die "refusing a profile inside the stock OpenCode data directory: $profile_real" ;;
  "$HOME/.config/opencode"|"$HOME/.config/opencode/"*)
    die "refusing a profile inside the stock OpenCode config directory: $profile_real" ;;
  "$HOME/.cache/opencode"|"$HOME/.cache/opencode/"*)
    die "refusing a profile inside the stock OpenCode cache directory: $profile_real" ;;
  "$HOME/.local/state/opencode"|"$HOME/.local/state/opencode/"*)
    die "refusing a profile inside the stock OpenCode state directory: $profile_real" ;;
  /) die "refusing the filesystem root as a profile" ;;
esac

mkdir -p "$profile_real/data" "$profile_real/config" "$profile_real/cache" "$profile_real/state" "$profile_real/tmp"

for name in data config cache state tmp; do
  directory="$profile_real/$name"
  resolved="$(cd -P "$directory" && pwd)"
  [ "$resolved" = "$directory" ] || die "refusing symlinked profile storage: $name -> $resolved"
  [ -O "$directory" ] || die "profile storage is not owned by the current user: $directory"
  chmod 700 "$directory" 2>/dev/null || true
done

# The database must stay inside the derived data directory. `debug paths db`,
# Config, and databasePath all resolve it through this same directory.
if [ -n "${OPENCODE_DB:-}" ] && [ "${OPENCODE_DB}" != ":memory:" ]; then
  data_real="$profile_real/data/opencode"
  case "$OPENCODE_DB" in
    */*) die "refusing nested OPENCODE_DB (${OPENCODE_DB}); use a filename inside $data_real" ;;
  esac
  mkdir -p "$data_real"
  [ ! -L "$data_real/$OPENCODE_DB" ] || die "refusing a symlinked OPENCODE_DB: $data_real/$OPENCODE_DB"
  db_real="$(canonical_allow_missing "$data_real/$OPENCODE_DB")"
  case "$db_real" in
    "$data_real"/*) ;;
    *) die "refusing OPENCODE_DB outside the derivative data directory: $db_real" ;;
  esac
fi

# An inherited server URL would silently attach the candidate to stock OpenCode.
if [ -n "${OPENCODE_SERVER_URL:-}" ] || [ -n "${OPENCODE_SERVER:-}" ]; then
  die "refusing inherited server attachment; pass --server explicitly"
fi

export OPENCODE_UNGUARDED_PROFILE="$profile_real"
export OPENCODE_UNGUARDED_ROOT="$root"
export OPENCODE_DB="${OPENCODE_DB:-}"
[ -z "$OPENCODE_DB" ] && unset OPENCODE_DB
export XDG_DATA_HOME="$profile_real/data"
export XDG_CONFIG_HOME="$profile_real/config"
export XDG_CACHE_HOME="$profile_real/cache"
export XDG_STATE_HOME="$profile_real/state"
export TMPDIR="$profile_real/tmp"

exec "$binary" "$@"
